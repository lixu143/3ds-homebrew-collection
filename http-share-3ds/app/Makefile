.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment (devkitPro pacman + 3ds-dev).")
endif

TOPDIR ?= $(CURDIR)
include $(DEVKITARM)/3ds_rules
PREFIX ?= $(DEVKITARM)/bin/arm-none-eabi-
MAKEROM_BIN ?= makerom

TARGET   := HTTPShare3DS
BUILD    := build
SOURCES  := source ../common
INCLUDES := source ../common
ROMFS    := romfs

APP_TITLE        := WifiShare 3DS
APP_PRODUCT_CODE := CTR-H-SHRE
APP_UNIQUE_ID    := 0x5A19

# SMDH icon (application name + 48x48/24x24 artwork) generated by
# tools/make_smdh.py. Committed so CI does not need Python to build the CIA.
ICON             := $(TOPDIR)/icon.smdh

ARCH := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft

CFLAGS   := -g -Wall -O2 $(ARCH) -ffunction-sections -fno-strict-aliasing
CFLAGS   += $(INCLUDE) -I$(DEVKITPRO)/libctru/include -I$(DEVKITPRO)/portlibs/3ds/include -D__3DS__
CXXFLAGS := $(CFLAGS) -fno-rtti -fno-exceptions
ASFLAGS  := $(ARCH)
LDFLAGS  := $(ARCH) -specs=3dsx.specs -g -Wl,--gc-sections
LIBS     := -lcitro2d -lcitro3d -lctru -lm
LIBDIRS  := $(CTRULIB) $(PORTLIBS) $(DEVKITPRO)/libctru/lib $(DEVKITPRO)/portlibs/3ds/lib
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT   := $(CURDIR)/$(TARGET)
export TOPDIR   := $(CURDIR)
export VPATH    := $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))
export DEPSDIR  := $(CURDIR)/$(BUILD)
export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir))

CFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
export OFILES := $(CFILES:.c=.o) $(CPPFILES:.cpp=.o)

.PHONY: all clean
all: $(BUILD)
$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile
clean:
	@rm -fr $(BUILD) $(TARGET).3dsx $(TARGET).elf $(TARGET).smdh $(TARGET).cia $(TARGET)-stripped.elf

else

DEPENDS := $(OFILES:.o=.d)
.PHONY: all
all: $(OUTPUT).3dsx $(OUTPUT).cia

$(OUTPUT).elf: $(OFILES)
	@echo " linking $@"
	@$(CC) $(LDFLAGS) -o $@ $(OFILES) $(LIBPATHS) $(LIBS)

3DSXTOOL := $(if $(wildcard $(DEVKITPRO)/tools/bin/3dsxtool),$(DEVKITPRO)/tools/bin/3dsxtool,$(DEVKITPRO)/tools/bin/3dsx)
$(OUTPUT).3dsx: $(OUTPUT).elf
	@echo " building $@"
	@$(3DSXTOOL) $< $@

$(OUTPUT)-stripped.elf: $(OUTPUT).elf
	@cp $(OUTPUT).elf $(OUTPUT)-stripped.elf
	@$(PREFIX)strip $(OUTPUT)-stripped.elf

$(OUTPUT).cia: $(OUTPUT)-stripped.elf $(ICON)
	@MAKEROM=$(MAKEROM_BIN); \
	 if ! command -v $$MAKEROM >/dev/null 2>&1 && [ ! -x "$$MAKEROM" ]; then \
	   echo "  (CIA skipped: makerom not available in this toolchain)"; exit 0; \
	 fi; \
	 $$MAKEROM -f cia -o $(OUTPUT).cia \
		-rsf $(TOPDIR)/httpshare_app.rsf -target t -exefslogo \
		-elf $(OUTPUT)-stripped.elf \
		-icon $(ICON) \
		-DAPP_TITLE="$(APP_TITLE)" \
		-DAPP_PRODUCT_CODE="$(APP_PRODUCT_CODE)" \
		-DAPP_UNIQUE_ID="$(APP_UNIQUE_ID)"
	@echo "built ... $(notdir $@)"

# icon.smdh is committed as a static asset, so CI needs no Python and no
# implicit rebuild rule (which could otherwise fire on checkout timestamps).
# Run `make icon` manually after editing tools/make_smdh.py to regenerate it.
.PHONY: icon
icon:
	@python3 $(TOPDIR)/tools/make_smdh.py || python $(TOPDIR)/tools/make_smdh.py

-include $(DEPENDS)
endif
